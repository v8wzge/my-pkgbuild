# Maintainer: <your name> <you@example.com>
#
# Repack of the vendor-supplied Debian binary package for the TOSHIBA ColorMFP
# CUPS driver.  Upstream ships no source and no upstream tarball, so the .deb
# itself is the only source; it must be placed next to this PKGBUILD.
#
# Payload analysis (contents of data.tar.xz):
#   /opt/Toshiba/toshibacolormfp/bin/sing20            Perl script, the CUPS filter
#   /opt/Toshiba/toshibacolormfp/ppd/TOSHIBA_ColorMFP_CUPS   PPD, FileVersion 7.114.3
#   /usr/lib/cups/filter/sing20                        -> /opt/.../bin/sing20
#   /usr/share/cups/model/Toshiba/TOSHIBA_ColorMFP_CUPS -> /opt/.../ppd/TOSHIBA_ColorMFP_CUPS
# There are no ELF binaries, hence arch=any.  The dependencies declared in the
# Debian control file (libc6, libcups2, libcupsimage2, libgcc1, libstdc++6,
# deepin-elf-verify) are leftovers from an alien conversion of an old RPM and
# do not reflect the real payload; the genuine runtime needs are perl + cups.

pkgname=toshiba-colormfp-cups
pkgver=7.114.3
pkgrel=1
pkgdesc="CUPS printer driver for TOSHIBA ColorMFP / e-STUDIO series"
arch=('any')
url="https://www.toshibatec.co.jp"
# The PPD header carries GPL-2.0-or-later, but the vendor package as a whole is
# distributed under a commercial licence (see the Debian copyright file).
license=('custom:Commercial')
depends=('perl' 'cups')
# The filter shells out to domainname(1) (line 11 of sing20) to decide whether to
# stamp the job as DSSC-certified.  Deliberately declared as no dependency at all:
# no official Arch repo package ships that command any more - inetutils 2.8 only
# provides hostname/dnsdomainname, net-tools 2.10 dropped it, and yp-tools (the
# historical provider, per the 2011 "deprecation of net-tools" news) is AUR-only.
# It is not needed either: without the command the filter only warns on stderr and
# emits CERTIFIED=0, then prints normally with exit status 0.
provides=('toshibacolormfp')
conflicts=('toshibacolormfp')

# Local binary blob, never downloaded.
_deb="signed_com.toshiba.toshibacolormfp_${pkgver}.deb"
source=("$_deb")
sha256sums=('42eb6716f567c83bc3d6dfa5522991c762d58fffdbf58b8a11498bf19685c9fd')

# A .deb is an ar(1) archive, not something makepkg can unpack on its own.
noextract=("$_deb")

build() {
  # Nothing to compile: the payload is a Perl script plus a PPD file.
  :
}

package() {
  cd "$srcdir"

  # Split the ar container.  This yields control.tar.gz, data.tar.xz,
  # debian-binary plus the vendor's "sign" and "sign.tar.gz" members, the
  # latter being a PKCS7 blob for the UOS/deepin deepin-elf-verify framework.
  # Those two are deliberately discarded: they are meaningless outside of a
  # Debian/UOS package manager.
  ar x "$_deb"

  # Install the payload verbatim.  bsdtar keeps the absolute symlinks (a
  # relative-symlink rewrite is not needed, both targets live inside /opt) and
  # the 0755 mode of the filter.  --no-same-owner is required because PKGBUILD
  # runs unprivileged while the archive is owned by root.
  bsdtar -xf data.tar.xz -C "$pkgdir" --no-same-owner

  # Ship the vendor licence text.
  bsdtar -xf control.tar.gz
  install -Dm644 copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
